# Copy to .env and fill in. Never commit .env.
# Meta Model API (dev.meta.ai), OpenAI-compatible:
DORA_API_BASE=https://api.meta.ai/v1
DORA_API_KEY=<your-key>
DORA_MODEL=muse-spark-1.3
# Other providers (Baseten, Modal) work the same way: change the base URL and model name.

# Meta WhatsApp Cloud API (SPEC-16):
WHATSAPP_TOKEN=<your-meta-whatsapp-token>
WHATSAPP_PHONE_NUMBER_ID=<your-whatsapp-phone-number-id>
WHATSAPP_VERIFY_TOKEN=<your-verify-token>
WHATSAPP_APP_SECRET=<your-meta-app-secret>
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_DAILY_LIMIT_PER_NUMBER=20
WHATSAPP_DAILY_LIMIT_TOTAL=200
